[Unit]
Description=Drone Image Processing API
After=network.target

[Service]
User=jbshah
WorkingDirectory=/var/www/drone-image_processing-api/
ExecStart=/var/www/drone-image_processing-api/venv/bin/gunicorn \
    -b 127.0.0.1:5000 \
    --log-file=/var/www/drone-image_processing-api/gunicorn.log \
    --log-level=debug \
    --capture-output \
    --enable-stdio-inheritance \
    --access-logfile=/var/www/drone-image_processing-api/access.log \
    --error-logfile=/var/www/drone-image_processing-api/error.log \
    app:app
Restart=always

[Install]
WantedBy=multi-user.target